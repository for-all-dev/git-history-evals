.DS_Store
._*
.idea
*.log
tmp/

*.py[cod]
*.egg
build
htmlcov

.venv

.claude/worktrees/
.env
.antigravitycli/

# Bulk dataset payloads — declared as sha256 blobs in manifest.json
artifacts/**/*.jsonl
artifacts/**/*.txt

# Local mirror of the DO Spaces bucket (convenience only; not canonical)
artifacts/bucket-mirror/

# Calibration crash-recovery checkpoints (transient; cleaned on a successful mine)
artifacts/**/_checkpoints/

# Curation-calibration loop runtime state (labels/score caches for crash resume —
# see scaffold/calibrate.py; the durable copies live in the Space next to the bundle)
artifacts/**/calibration-*/**/state/
# Writer-conversation provenance — mirrored to the Space, too bulky for git
artifacts/**/writer_transcript.json
/local/

/hf/**/*.jsonl

/docs/meetings/*.pdf

# prebuilt Isabelle session heaps (large, local; keyed by version inside,
# e.g. .isabelle-heaps/.isabelle/Isabelle2025{,-2}/ for l4v / AFP)
.isabelle-heaps/

# ablation pipeline: source checkouts, heaps, and bulk mined data are never committed
# (repos are pinned in pipeline/repos.tsv; datasets live in the forall-ablations Space)
/data/lean/
/data/**/.lake/
/.ablate-heaps/
/afp-*/
/scratchpad_pilot/
/artifacts/**/*.jsonl
/artifacts/**/*.txt
/baselines/results/
/baselines/baseline-results.jsonl
/challenges.jsonl
/.elan/

# LaTeX build artifacts (but NOT .olcli.json which pins project config)
*.aux
*.bbl
*.blg
*.log
*.out
*.pdf
*.synctex.gz
