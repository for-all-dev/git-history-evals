{
  "proof_assistant": "coq",
  "proof_file_globs": [
    "*.v"
  ],
  "exclude_globs": [
    "vendor",
    "third_party",
    "external",
    "_build",
    "build",
    ".build",
    "node_modules",
    "__pycache__"
  ],
  "build_files": {
    "Makefile": "make",
    "_CoqProject": "coq_makefile"
  },
  "build_commands": [
    "make"
  ],
  "hole_markers": [
    {
      "regex": "\\bsorry\\b",
      "kind": "sorry"
    },
    {
      "regex": "\\bAdmitted\\b",
      "kind": "admitted"
    },
    {
      "regex": "\\badmit\\b",
      "kind": "admit"
    },
    {
      "regex": "\\boops\\b",
      "kind": "oops"
    }
  ],
  "declaration_patterns": [
    "^\\s*(?:Theorem|Lemma|Proposition|Corollary|Fact|Remark|Example|Definition|Fixpoint|Program)\\s+(\\w+)"
  ],
  "commit_signals": {
    "proof_complete": [
      "\\bclose[ds]?\\b",
      "\\bfill(?:ed|ing)?\\b",
      "\\bfinish(?:ed|ing)?\\b",
      "\\bsolv(?:e[ds]?|ing)\\b",
      "\\bremov(?:e[ds]?|ing)\\s+(?:sorry|admitted|oops)\\b",
      "\\bno\\s+(?:more\\s+)?sorry\\b",
      "\\bno\\s+(?:more\\s+)?admitted\\b",
      "\\bqed\\b",
      "\\bproof\\s+complete\\b",
      "\\bcomplete[ds]?\\s+proof\\b",
      "\\bresolv(?:e[ds]?|ing)\\s+(?:goal|proof|sorry|admitted)\\b"
    ],
    "proof_new": [
      "\\badd(?:ed|ing)?\\s+(?:lemma|theorem|corollary|proposition|fact)\\b",
      "\\bnew\\s+(?:lemma|theorem|corollary|proof)\\b",
      "\\bprov(?:e[ds]?|ing)\\s+\\w+\\b",
      "\\bproof\\s+of\\b",
      "\\blemma\\b",
      "\\btheorem\\b",
      "\\bcorollary\\b"
    ],
    "proof_add": [
      "\\bwip\\b",
      "\\bwork\\s+in\\s+progress\\b",
      "\\bpartial\\b",
      "\\bprogress\\b",
      "\\bmore\\s+(?:cases|tactic|steps)\\b",
      "\\btactic\\b",
      "\\binduction\\b",
      "\\brewrite\\b",
      "\\bsimplif\\b",
      "\\bapply\\b",
      "\\bauto\\b",
      "\\bomega\\b",
      "\\bring\\b",
      "\\bdestructur\\b",
      "\\bcase\\s+split\\b",
      "\\bimprove\\s+proof\\b",
      "\\bclean\\s+up\\s+proof\\b"
    ],
    "spec_change": [
      "\\bspecif(?:ication|y|ied)\\b",
      "\\bstatement\\b",
      "\\bgenerali[sz]e\\b",
      "\\bstrengthen\\b",
      "\\bweaken\\b",
      "\\bprecondition\\b",
      "\\bpostcondition\\b",
      "\\bhypothes[ie]s\\b",
      "\\bchanged?\\s+(?:spec|statement|type|signature)\\b",
      "\\bupdat(?:e[ds]?|ing)\\s+(?:spec|statement|type)\\b",
      "\\brelax\\b",
      "\\brefin(?:e[ds]?|ing)\\b"
    ],
    "infra": [
      "\\bbump\\b",
      "\\bupgrad(?:e[ds]?|ing)\\b",
      "\\bdependabot\\b",
      "\\bdependency\\b",
      "\\bdependencies\\b",
      "\\bci\\b",
      "\\bgithub\\s+actions?\\b",
      "\\bdocker\\b",
      "\\bmakefile\\b",
      "\\bnix\\b",
      "\\bopam\\b",
      "\\bsubmodule\\b",
      "\\bchore\\b",
      "\\brelease\\b",
      "\\bversion\\b"
    ],
    "refactor": [
      "\\brefactor\\b",
      "\\brename\\b",
      "\\bmov(?:e[ds]?|ing)\\b",
      "\\breorganiz\\b",
      "\\bclean(?:\\s+up|up)?\\b",
      "\\bextract\\b",
      "\\bsplit\\b",
      "\\bmerge\\b",
      "\\bdedup\\b",
      "\\bdeduplicat\\b"
    ],
    "fix": [
      "\\bfix(?:es|ed|ing)?\\b",
      "\\bbug\\b",
      "\\bpatch\\b",
      "\\bcorrect\\b",
      "\\brepair\\b",
      "\\bregression\\b",
      "\\bissue\\b",
      "\\bworkaround\\b"
    ]
  },
  "proof_context_regex": "\\b(proof|lemma|theorem|sorry|admitted|oops|tactic|coq|corollary)\\b",
  "classification_priority": [
    "infra",
    "proof_complete",
    "spec_change",
    "proof_new",
    "proof_add",
    "refactor",
    "fix"
  ],
