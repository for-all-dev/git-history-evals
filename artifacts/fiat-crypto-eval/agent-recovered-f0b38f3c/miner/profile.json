{
  "proof_assistant": "coq",
  "proof_file_globs": [
    "**/*.v"
  ],
  "exclude_globs": [
    ".github/**",
    "etc/**",
    "src/ExtractionOCaml/**",
    "src/ExtractionHaskell/**",
    "src/ExtractionJsOfOCaml/**",
    "src/PerfTesting/**"
  ],
  "build_files": {
    "Makefile": "make",
    "coq-fiat-crypto.opam": "opam install ."
  },
  "build_commands": [
    "make coq",
    "make coq-without-bedrock2"
  ],
  "hole_markers": [
    {
      "regex": "\\bAdmitted\\b",
      "kind": "admitted"
    },
    {
      "regex": "\\badmit\\b",
      "kind": "admit"
    }
  ],
  "declaration_patterns": [
    "^\\s*(?:Theorem|Lemma|Example|Fact)\\s+(\\w+)",
    "^\\s*(?:Global\\s+|Local\\s+)?(?:Instance)\\s+(\\w+)",
    "^\\s*(?:Global\\s+)?Definition\\s+(\\w+)",
    "^\\s*Fixpoint\\s+(\\w+)",
    "^\\s*(?:Inductive|Record|Class)\\s+(\\w+)"
  ],
  "commit_signals": {
    "proof_complete": [
      "[Cc]omplete\\s+proof",
      "[Ff]inish.*proof",
      "[Ff]ix.*admit",
      "[Ff]ix\\s+Qed",
      "[Ff]inal\\s+(?:cleanup|proof)",
      "[Vv]erifi",
      "[Pp]rove\\s+(?:correctness|to)",
      "[Pp]roof\\s+(?:for|of|that)",
      "[Ii]mplement\\s+and\\s+prove",
      "implement\\s+and\\s+prove",
      "[Ss]witch.*complete\\s+proof"
    ],
    "proof_add": [
      "[Aa]dd\\s+(?:proof|lemma|theorem|spec|separation)",
      "[Ii]nitial\\s+(?:spec|proof|double)",
      "[Ss]pec(?:s)?\\s+(?:based|for|and\\s+proof)",
      "[Ss]eparation\\s+logic",
      "(?:programs?|specs?)\\s+and\\s+separation",
      "[Bb]edrock\\d*\\s+(?:code|impl)",
      "[Ee]d[0-9]+.*[Ss]pec",
      "[Ee]dwards.*[Ss]pec"
    ],
    "spec_change": [
      "[Aa]dapt\\s+(?:to|w\\.r\\.t\\.)",
      "[Aa]dapt\\s+to\\s+(?:https?://|coq/)",
      "[Rr]equire\\s+Coq\\s+\\d",
      "[Uu]pdate\\s+ZRange",
      "[Ss]pec(?:ification)?.*[Uu]pdate",
      "paperif",
      "io\\s+spec",
      "[Uu]pdate\\s+for\\s+(?:Zig|Coq)"
    ],
    "refactor": [
      "[Rr]efactor\\b",
      "[Cc]leanup\\b",
      "[Cc]lean\\s+up\\b",
      "[Rr]eorganiz",
      "[Rr]ename\\b",
      "\\buse\\s+\\w+\\s+in\\b",
      "replace\\s+\\w+\\s+with\\b",
      "\\bpull\\s+\\w+\\s+(?:into|from)\\b",
      "\\bfactor\\b.*(?:proof|out)"
    ],
    "fix": [
      "^[Ff]ix\\b",
      "^fix\\s*:",
      "[Bb]ug\\s+fix",
      "[Hh]avoc\\s+flags",
      "[Rr]evert\\s+\\\"",
      "[Ff]ix\\s+(?:variable|error|conflict|sed|ulimit|typo)"
    ],
    "infra": [
      "\\b[Bb]ump\\b",
      "\\bbump\\b",
      "[Dd]ependabot\\b",
      "[Ww]orkflow\\b",
      "[Cc]oq.docker",
      "[Gg]it[Hh]ub\\s+[Aa]ctions?",
      "(?:actions|setup|upload|download)-artifact",
      "[Ww]indows\\s+CI",
      "[Mm]ac[Oo][Ss]\\s+(?:CI|matrix)",
      "[Oo]cam[Ll]\\b",
      "[Dd]ocker\\b",
      "[Oo]pam\\b",
      "[Zz]ig\\s+\\d",
      "[Rr]ust:?\\s+",
      "[Jj][Ss](?:oo)?\\b",
      "[Rr]egenerate\\b",
      "[Rr]eformat\\b",
      "disk\\s+space",
      "[Dd]ependency|[Dd]ependencies",
      "\\bCI\\b",
      "[Cc]oq\\s+version",
      "\\bopam\\b",
      "[Aa]lpine\\b",
      "\\bGHC\\b"
    ]
  },
  "proof_context_regex": "(?:proof|lemma|theorem|spec|verif|coq|tactic|rewrite|induction|algebra|curve|arithmetic|crypto|bedrock|edwards|montgomery|weierstrass|barrett|solinas|field|ring|group|jacobian|scalar|felem)",
