  "proof_assistant": "isabelle",
  "proof_file_globs": [
    "**/*.thy",
    "**/*.ML"
  ],
  "exclude_globs": [
    "**/.isabelle/**",
    "**/document/**",
    "**/*.pdf",
    "**/*.png",
    "**/*.svg",
    "**/.heap/**"
  ],
  "build_files": {
    "ROOT": "isabelle build",
    "ROOTS": "isabelle build -d .",
    "Makefile": "make"
