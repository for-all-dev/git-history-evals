    {
      "regex": "\\bsorry\\b",
      "kind": "sorry"
    },
    {
      "regex": "\\boops\\b",
      "kind": "oops"
    }
  ],
  "declaration_patterns": [
    "^\\s*lemma\\s+(\\w+)",
    "^\\s*theorem\\s+(\\w+)",
    "^\\s*corollary\\s+(\\w+)",
