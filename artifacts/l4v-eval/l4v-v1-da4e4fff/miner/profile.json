  "proof_start_regex": "^\\s*(?:proof|apply|by)\\b",
  "proof_end_regex": "^\\s*(?:qed|done|sorry|oops)\\b",
  "commit_signals": {
    "infra": [
      "^github[:\\s]",
      "^run_tests[:\\s]",
      "^trivial:",
      "^docs:",
      "^isabelle20\\d\\d",
      "^tests\\.xml",
      "^makefile",
      "^ROOT\\b",
      "\\bgithub actions\\b",
      "^\\.github",
      "\\[NO_PROOF\\]",
      "ci[:\\s]"
    ],
    "proof_complete": [
      "sorry.?free",
      "sorry free",
      "clear.*sorry",
      "close.*sorry",
      "remove.*sorry",
      "-\\s*\\d+\\s+sorr(?:y|ies)",
      "sorr(?:y|ies).*(?:free|done|clear|gone|resolved)",
      "finish.*sorry",
      "\\bsorry.*proof\\b",
      "proof.*complete\\b"
    ],
    "spec_change": [
      "^[^:]*\\baspec\\b[^:]*:",
      "^[^:]*\\bhaskell\\b[^:]*:",
      "^[^:]*\\bdesign\\b[^:]*:",
      "^[^:]*\\bspec\\b[^:]*:"
    ],
    "proof_add": [
      "\\badd (?:lemma|lemmas|theorem|corollary|proof|rule|corres|ccorres)\\b",
      "\\b(?:lemma|lemmas|theorem|definition|rule)s? for\\b",
      "\\bnew (?:lemma|proof|theorem|corollary)\\b",
      "\\bprove\\b",
      "\\blemmas?\\b.*\\badd\\b"
    ],
    "refactor": [
      "\\barch.split\\b",
      "\\barch.prefix\\b",
      "\\bgiven.*(?:arch|prefix)\\b",
      "\\brename\\b",
      "\\brefactor\\b",
      "\\bcleanup\\b",
      "\\breorganis[ez]\\b",
      "\\bgenerali[sz]e\\b",
      "\\bmove.*(?:lemma|proof|theorem)\\b",
      "\\bconsolidate\\b",
      "\\bde.duplicat\\b",
      "\\barch-split\\b",
      "\\barch prefix\\b"
    ],
    "fix": [
      "\\bfix\\b(?!.*\\bprefix\\b)",
      "\\brepair\\b",
      "\\bworkaround\\b",
      "\\bcorrect(?:ed|ion)?\\b",
      "\\bbroken\\b.*\\b(?:proof|lemma)\\b"
    ]
  },
  "proof_context_regex": "\\b(?:lemma|theorem|corollary|proof|qed|done|corres|ccorres|refin|invar|sorry|oops|simp|clarsimp|fastforce|auto|blast|wp|wpsimp|crunch|ctac|ceqv)\\b",
