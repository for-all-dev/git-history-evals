{
  "proof_assistant": "coq",
  "proof_file_globs": [
    "**/*.v",
    "**/*.vp"
  ],
  "exclude_globs": [
    "flocq/**",
    "MenhirLib/**",
    "cparser/Parser.v",
    "extraction/**",
    "build/**"
  ],
  "build_files": {
    "Makefile": "make proof"
  },
  "build_commands": [
    "make proof"
  ],
  "hole_markers": [
    {
      "regex": "\\bAdmitted\\b",
      "kind": "admitted"
    },
    {
      "regex": "\\badmit\\b",
      "kind": "admit"
    },
    {
      "regex": "\\bADMITTED\\b",
      "kind": "admitted_axiom"
    }
  ],
  "declaration_patterns": [
    "^\\s*(?:Theorem|Lemma|Remark|Corollary|Proposition)\\s+(\\w+)",
    "^\\s*(?:Definition|Fixpoint|CoFixpoint)\\s+(\\w+)",
    "^\\s*(?:Inductive|CoInductive)\\s+(\\w+)",
    "^\\s*Instance\\s+(\\w+)",
    "^\\s*Function\\s+(\\w+)",
    "^\\s*Record\\s+(\\w+)",
    "^\\s*Program\\s+(?:Definition|Fixpoint)\\s+(\\w+)",
    "^\\s*Nondetfunction\\s+(\\w+)"
  ],
